; E-Learning Environment Configuration
; Copy file ini ke .env dan isi dengan nilai yang sesuai.

; --- App Settings ---
APP_ENV=development
APP_DEBUG=true
APP_NAME=EduLearn
APP_TIMEZONE=Asia/Makassar

; --- Database (Supabase PostgreSQL) ---
DB_HOST=your-supabase-host.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_SSLMODE=require
